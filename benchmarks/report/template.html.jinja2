<script>
const DATA = JSON.parse(document.getElementById('pygixml-data').textContent);

// Two runtimes can load this exact HTML file: a published Artifact page
// (window.claude.use('downloads') handles saves, and a plain anchor+Blob
// click is inert there) or a plain browser tab -- opened straight from
// disk, or the chat's own artifact preview -- where window.claude.use
// doesn't exist and the classic anchor+Blob trick is what actually works.
// Feature-detect once and use whichever applies.
let _downloadsApi = undefined; // undefined = not checked yet, null = checked, unavailable
(async () => {
  if (window.claude && typeof window.claude.use === 'function') {
    try { _downloadsApi = await window.claude.use('downloads'); }
    catch (e) { _downloadsApi = null; }
  } else {
    _downloadsApi = null;
  }
})();

async function downloadJSON(name) {
  const text = JSON.stringify(DATA[name], null, 2);
  const filename = name + '.json';
  if (_downloadsApi) {
    try {
      await _downloadsApi.save({ filename, data: new Blob([text], { type: 'application/json' }) });
    } catch (e) { /* viewer declined, or a transient error -- no-op */ }
    return;
  }
  const blob = new Blob([text], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

Chart.defaults.color = '#8b93a7';
Chart.defaults.borderColor = '#232938';
Chart.defaults.font.family = "-apple-system, 'Segoe UI', sans-serif";

{{ chart_scripts | safe }}

// Charts inside a collapsed <details> are built against a hidden
// (0x0) canvas and can come out mis-sized; force a resize the first
// time each block is actually opened, as a safety net alongside
// Chart.js's own ResizeObserver.
document.querySelectorAll('.mini-details').forEach(function (el) {
  el.addEventListener('toggle', function () {
    if (!el.open) return;
    el.querySelectorAll('canvas').forEach(function (canvas) {
      const chart = Chart.getChart(canvas);
      if (chart) chart.resize();
    });
  });
});
</script>
