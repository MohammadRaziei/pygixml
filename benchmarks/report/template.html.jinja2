<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>pygixml Benchmarks</title>
<style>
:root {
  --bg: #0b0e14;
  --bg-panel: #12161f;
  --bg-panel-2: #171c28;
  --border: #232938;
  --text: #e6e9ef;
  --text-dim: #8b93a7;
  --accent: #e67225;
  --accent-2: #35d0ba;
  --warn: #ffb454;
  --bad: #ff6b81;
  --good: #35d0ba;
  --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.55;
}
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px 80px; }

/* ---- Hero ---- */
/* ---- Navbar ---- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(11, 14, 20, 0.85);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}
.navbar-inner {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 24px;
}
.navbar-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.navbar-brand img { height: 22px; width: auto; }
.navbar-links { display: flex; align-items: center; gap: 22px; }
.navbar-link {
  font-size: 14px;
  text-decoration: none;
  color: var(--text-dim);
  transition: color 150ms ease;
}
.navbar-link:hover { color: var(--text); }
.navbar-link.current { color: var(--accent); font-weight: 600; }
.navbar-cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--accent);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  padding: 7px 13px;
  border-radius: 7px;
  text-decoration: none;
  transition: opacity 150ms ease;
}
.navbar-cta:hover { opacity: 0.85; }
.navbar-cta svg { width: 14px; height: 14px; }
@media (max-width: 480px) {
  .navbar-cta-text { display: none; }
  .navbar-cta { padding: 7px 9px; }
}

.hero {
  padding: 90px 24px 70px;
  text-align: center;
  background:
    radial-gradient(ellipse 900px 500px at 50% -10%, rgba(230,114,37,0.20), transparent 60%),
    linear-gradient(180deg, var(--bg) 0%, var(--bg) 100%);
  border-bottom: 1px solid var(--border);
}
.hero .eyebrow {
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--accent-2);
  font-weight: 600;
  margin-bottom: 18px;
}
.hero h1 {
  font-size: clamp(28px, 4.4vw, 48px);
  line-height: 1.18;
  margin: 0 auto 20px;
  max-width: 880px;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.hero h1 .hl { color: var(--accent); }
.hero p.sub {
  color: var(--text-dim);
  font-size: 17px;
  max-width: 660px;
  margin: 0 auto;
}
.hero .meta {
  margin-top: 28px;
  font-family: var(--mono);
  font-size: 12.5px;
  color: var(--text-dim);
}

/* ---- Sections ---- */
section { padding: 64px 0; border-bottom: 1px solid var(--border); }
section:last-of-type { border-bottom: none; }
.kicker {
  font-size: 12.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent-2);
  font-weight: 700;
  margin-bottom: 10px;
}
h2 { font-size: 27px; margin: 0 0 12px; letter-spacing: -0.01em; }
h3.op-title { font-size: 18px; margin: 44px 0 6px; }
h3.op-title:first-of-type { margin-top: 8px; }
.lede { color: var(--text-dim); font-size: 16px; max-width: 740px; margin: 0 0 32px; }
.lede strong { color: var(--text); font-weight: 650; }
.op-note { color: var(--text-dim); font-size: 13.5px; max-width: 740px; margin: 0 0 12px; }
.op-winner { font-size: 15px; margin: 0 0 20px; color: var(--text); }
.op-winner strong { color: var(--accent-2); font-weight: 700; }

.mini-details { margin-bottom: 8px; }
.mini-details summary {
  cursor: pointer;
  user-select: none;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--accent);
  padding: 10px 4px;
  list-style: none;
}
.mini-details summary::-webkit-details-marker { display: none; }
.mini-details summary::before {
  content: '\25B8';
  display: inline-block;
  margin-right: 6px;
  transition: transform 150ms ease;
}
.mini-details[open] summary::before { transform: rotate(90deg); }
.mini-details summary:hover { color: var(--accent-2); }

.mini-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 14px;
  margin-bottom: 8px;
  margin-top: 4px;
}
.mini-panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 11px;
  padding: 14px 16px;
}
.mini-label {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--text-dim);
  margin-bottom: 8px;
}
.mini-chart-box { position: relative; height: 96px; }
.mini-values {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text-dim);
  margin-top: 6px;
  line-height: 1.5;
}
.mini-subhead {
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: var(--text-dim);
  margin: 4px 0 4px;
}
.mini-mem-subhead { margin-top: 12px; border-top: 1px dashed var(--border); padding-top: 10px; }

.panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 26px;
  margin-bottom: 22px;
}
.panel h4 { margin: 0 0 4px; font-size: 14px; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
.chart-box { position: relative; height: 320px; }
.chart-box.tall { height: 420px; }
.chart-pair { display: grid; grid-template-columns: 1fr; gap: 18px; }

/* ---- Tables ---- */
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); }
th { color: var(--text-dim); font-weight: 600; font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; }
td.num, th.num { text-align: right; font-family: var(--mono); }
tr:last-child td { border-bottom: none; }

/* ---- Section-local download ---- */
.section-download { margin-top: 22px; }
.dl-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-panel-2);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 9px 14px;
  border-radius: 9px;
  font-size: 13px;
  font-family: var(--mono);
  cursor: pointer;
  transition: border-color .15s, background .15s;
}
.dl-btn:hover { border-color: var(--accent); background: #1a2030; }
.dl-btn svg { width: 14px; height: 14px; flex: none; }

footer {
  padding: 40px 0 20px;
  color: var(--text-dim);
  font-size: 13px;
  text-align: center;
}
footer .sysline { font-family: var(--mono); font-size: 12px; margin-bottom: 10px; }
footer a { color: var(--accent); text-decoration: none; }
footer a:hover { text-decoration: underline; }

.env-table { max-width: 480px; margin: 0 auto; }
.env-table td:first-child { color: var(--text-dim); width: 40%; }
.env-table td:last-child { font-family: var(--mono); color: var(--text); text-align: right; }
.env-table tr:last-child td { border-bottom: none; }

.legend-note { font-size: 12.5px; color: var(--text-dim); margin-top: 10px; }
code { font-family: var(--mono); background: var(--bg-panel-2); padding: 1px 6px; border-radius: 5px; font-size: 0.92em; }
</style>
</head>
<body>

<header class="navbar">
  <div class="navbar-inner">
    <a class="navbar-brand" href="https://mohammadraziei.github.io/pygixml/">
      <img src="https://raw.githubusercontent.com/MohammadRaziei/pygixml/master/docs/images/pygixml.svg" alt="pygixml">
    </a>
    <div class="navbar-links">
      <a class="navbar-link" href="https://mohammadraziei.github.io/pygixml/docs/index.html">Docs</a>
      <a class="navbar-link current" href="https://mohammadraziei.github.io/pygixml/benchmarks/index.html">Benchmarks</a>
      <a class="navbar-cta" href="https://github.com/MohammadRaziei/pygixml" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.1.83-.27.83-.58v-2c-3.34.72-4.04-1.6-4.04-1.6-.55-1.37-1.33-1.74-1.33-1.74-1.09-.74.08-.72.08-.72 1.2.09 1.84 1.24 1.84 1.24 1.07 1.82 2.8 1.3 3.49 1 .1-.77.42-1.3.76-1.6-2.66-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .31.22.69.83.57A12 12 0 0 0 12 .3Z"/></svg>
        <span class="navbar-cta-text">GitHub</span>
      </a>
    </div>
  </div>
</header>

<div class="hero">
  <div class="eyebrow">pygixml benchmark report &middot; generated {{ generated_at }}</div>
  <h1>{{ headline | safe }}</h1>
  <p class="sub">{{ subhead | safe }}</p>
  <div class="meta">{{ meta_line }}</div>
</div>

<div class="wrap">

{% if has_memory %}
<!-- ========================= MEMORY ========================= -->
<section id="memory">
  <div class="kicker">Memory</div>
  <h2>Peak RSS vs. input size</h2>
  <p class="lede">
    Every library here that builds a DOM (or an equivalent in-memory dict/tree)
    uses more RAM as the input file grows. <strong>pygixml.jsonify.stream_dump</strong>
    is the one approach that doesn't: it converts XML straight to JSON without ever
    holding the whole tree in memory, so its curve is flat &mdash; O(1) against the
    others' O(n). That's a difference in <em>growth rate</em>, not a fixed multiplier:
    the gap widens as input grows, so no single "N&times; less memory" number at one
    input size represents it fairly &mdash; the chart does.{{ memory_lede_extra }}
  </p>

  <div class="panel">
    <h4>Peak RSS vs. input size</h4>
    <p class="op-note">Log scale on both axes &mdash; a flat line here means constant memory; a line with the same slope as the others means it scales with input, same as everyone else.</p>
    <div class="chart-box tall"><canvas id="chart-memory"></canvas></div>
    {% if memory_complexity_note %}<p class="legend-note">{{ memory_complexity_note | safe }}</p>{% endif %}
  </div>

  {% if memory_has_speed %}
  <div class="panel">
    <h4>Speed vs. input size (same 4 approaches, same isolated-process runs)</h4>
    <p class="op-note">
      This is <code>stream_dump</code>'s own speed comparison &mdash; separate from the
      <code>xml_to_json</code> panel further down, which only measures pygixml's DOM-based
      <code>jsonify.dumps</code>. Best of 3 timed repeats per process, after one untimed
      warm-up call.
    </p>
    <div class="chart-box tall"><canvas id="chart-memory-speed"></canvas></div>
  </div>
  {% endif %}

  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('memory')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      memory.json
    </button>
  </div>
</section>
{% endif %}

{% if has_scaling %}
<!-- ========================= SCALING ========================= -->
<section id="scaling">
  <div class="kicker">Time complexity</div>
  <h2>The shape that flatters us, and the one that doesn't</h2>
  <p class="lede">
    <strong>stream_dump</strong> writes optimistically and patches the output
    file in place once it learns a tag repeats. For the shape almost all real
    giant XML actually has &mdash; one repeated tag per nesting level, like
    <code>&lt;orders&gt;&lt;order&gt;...&lt;/order&gt;...&lt;/orders&gt;</code>
    &mdash; that's O(n). We also generate the one shape where it isn't: two
    different tags repeating and interleaving at the same level. We're
    showing that curve here on purpose, not just citing it in the docs.
  </p>

  <div class="panel">
    <h4>Time vs. N, by shape</h4>
    <p class="op-note">Same operation (<code>jsonify.stream_dump</code>), two different input shapes. Log-log, so a straight line means a power-law relationship &mdash; the slope tells you which power.</p>
    <div class="chart-box tall"><canvas id="chart-scaling"></canvas></div>
    <p class="legend-note">{{ scaling_note | safe }}</p>
  </div>

  {% if scaling_dom_available %}
  <div class="panel">
    <h4>Records-shape XML &rarr; JSON, DOM-based approaches</h4>
    <p class="op-note">For reference: everyone's roughly-linear time on the realistic shape, at moderate N.</p>
    <div class="chart-box"><canvas id="chart-scaling-dom"></canvas></div>
  </div>
  {% endif %}

  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('scaling')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      scaling.json
    </button>
  </div>
</section>
{% endif %}

{% macro op_body(op) %}
  {% if op.winner_summary %}<p class="op-winner">{{ op.winner_summary | safe }}</p>{% endif %}
  {% if op.memory_summary %}<p class="op-winner">{{ op.memory_summary | safe }}</p>{% endif %}

  <details class="mini-details">
    <summary>See per-entry detail ({{ op.entries|length }} corpus entries)</summary>
    <div class="mini-grid">
      {% for entry in op.entries %}
      <div class="mini-panel">
        <div class="mini-label">{{ entry.label }}</div>
        <div class="mini-subhead">Time (ms)</div>
        <div class="mini-chart-box"><canvas id="{{ entry.id }}"></canvas></div>
        <div class="mini-values">{{ entry.values_text }}</div>
        {% if entry.mem_id %}
        <div class="mini-subhead mini-mem-subhead">Peak memory (MB)</div>
        <div class="mini-chart-box"><canvas id="{{ entry.mem_id }}"></canvas></div>
        <div class="mini-values">{{ entry.mem_text }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </details>

  {% if op.has_time_trend or op.has_mem_trend %}
  <div class="chart-pair" style="margin-top:18px;">
    {% if op.has_time_trend %}
    <div class="panel">
      <h4>Time vs. input size (ms, log scale, lower is better)</h4>
      <div class="chart-box"><canvas id="chart-time-trend-{{ op.key }}"></canvas></div>
    </div>
    {% endif %}
    {% if op.has_mem_trend %}
    <div class="panel">
      <h4>Peak memory vs. input size (MB, lower is better)</h4>
      <div class="chart-box"><canvas id="chart-mem-trend-{{ op.key }}"></canvas></div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if op.has_tp_chart %}
  <div class="panel" style="margin-top:18px;">
    <h4>Throughput vs. input size (MB/s, higher is better)</h4>
    <div class="chart-box"><canvas id="chart-tp-{{ op.key }}"></canvas></div>
  </div>
  {% endif %}
{% endmacro %}

{% if has_throughput %}

<!-- ========================= PARSE ========================= -->
{% if op_parse %}
<section id="op-parse">
  <div class="kicker">1 of 5 &middot; pugixml core</div>
  <h2>parse &mdash; build a tree from the XML string, discard it</h2>
  <p class="lede">{{ op_parse.note }} Time per corpus entry (best of {{ repeats }} runs) and
     peak memory (each measured in its own isolated process).</p>
  {{ op_body(op_parse) }}
  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('throughput')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      throughput.json
    </button>
    {% if has_throughput_memory %}
    <button class="dl-btn" onclick="downloadJSON('throughput_memory')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      throughput_memory.json
    </button>
    {% endif %}
  </div>
</section>
{% endif %}

<!-- ========================= ITERPARSE / STREAMING ========================= -->
{% if op_iterparse %}
<section id="op-iterparse">
  <div class="kicker">2 of 5 &middot; yxml core</div>
  <h2>iterparse &mdash; stream every element, never hold the whole document</h2>
  <p class="lede">{{ op_iterparse.note }}</p>
  {{ op_body(op_iterparse) }}
</section>
{% endif %}

<!-- ========================= JSONIFY ========================= -->
{% if op_jsonify %}
<section id="op-jsonify">
  <div class="kicker">3 of 5</div>
  <h2>jsonify &mdash; XML to JSON, end to end</h2>
  <p class="lede">{{ op_jsonify.note }}</p>
  {% if jsonify_narrative %}{{ jsonify_narrative | safe }}{% endif %}
  {{ op_body(op_jsonify) }}
</section>
{% endif %}

<!-- ========================= OBJECTIFY ========================= -->
{% if op_objectify %}
<section id="op-objectify">
  <div class="kicker">4 of 5</div>
  <h2>objectify &mdash; lazy attribute-style access</h2>
  <p class="lede">{{ op_objectify.note }}</p>
  {{ op_body(op_objectify) }}
</section>
{% endif %}

<!-- ========================= DICTIFY ========================= -->
{% if op_dictify_dom %}
<section id="op-dictify">
  <div class="kicker">5 of 5</div>
  <h2>dictify &mdash; XML to plain dict, DOM mode and streaming mode</h2>
  <p class="lede">
    Two independent comparisons, not one: dictify's regular (DOM) mode against
    <code>xmltodict.parse</code>, and its streaming mode (<code>dictify.iterdict</code>)
    against xmltodict's own streaming mode (<code>item_depth</code> +
    <code>item_callback</code>) &mdash; xmltodict genuinely supports both, so
    neither comparison is a DOM tool facing off against a streaming-only one.
  </p>

  <h3 class="op-title">DOM mode</h3>
  <p class="op-note">{{ op_dictify_dom.note }}</p>
  {{ op_body(op_dictify_dom) }}

  {% if op_dictify_stream %}
  <h3 class="op-title">Streaming mode</h3>
  <p class="op-note">{{ op_dictify_stream.note }}</p>
  {{ op_body(op_dictify_stream) }}
  {% endif %}

  {% if has_dictify_mode_chart %}
  <div class="panel" style="margin-top:18px;">
    <h4>DOM vs. streaming, both libraries, same axes (ms, log scale)</h4>
    <p class="op-note">Solid line = streaming mode, dashed = DOM mode &mdash; is streaming actually worth it, and for whom?</p>
    <div class="chart-box tall"><canvas id="chart-dictify-modes"></canvas></div>
  </div>
  {% endif %}

  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('throughput')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      throughput.json
    </button>
    {% if has_throughput_memory %}
    <button class="dl-btn" onclick="downloadJSON('throughput_memory')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      throughput_memory.json
    </button>
    {% endif %}
  </div>
</section>
{% endif %}

{% endif %}

{% if has_sizes %}
<!-- ========================= SIZE ========================= -->
<section id="size">
  <div class="kicker">Footprint</div>
  <h2>What you actually download</h2>
  <p class="lede">
    Real wheel sizes for the current platform, resolved directly through
    <a href="https://github.com/MohammadRaziei/pip-size" style="color:var(--accent)">pip-size</a>'s
    Python API (not its CLI) &mdash; no downloads, no installs, just querying PyPI's index.
    ElementTree needs nothing: it ships with Python itself.
  </p>
  <div class="panel">
    <div class="chart-box"><canvas id="chart-size"></canvas></div>
  </div>

  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('sizes')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      sizes.json
    </button>
  </div>
</section>
{% endif %}

{% if system_info %}
<!-- ========================= ENVIRONMENT ========================= -->
<section id="environment">
  <div class="kicker">Environment</div>
  <h2>What this ran on</h2>
  <p class="lede">
    Every number above came from this one machine. Recorded automatically by
    <code>system_info.py</code> at run time &mdash; not filled in by hand.
  </p>
  <div class="panel">
    <table class="env-table">
      <tbody>
        <tr><td>CPU</td><td>{{ system_info.cpu_model }}</td></tr>
        <tr><td>Logical cores</td><td>{{ system_info.logical_cores }}</td></tr>
        {% if system_info.ram_gib %}<tr><td>RAM</td><td>{{ system_info.ram_gib }} GiB</td></tr>{% endif %}
        <tr><td>Architecture</td><td>{{ system_info.architecture }}</td></tr>
        <tr><td>OS</td><td>{{ system_info.os }}</td></tr>
        <tr><td>Python</td><td>{{ system_info.python_implementation }} {{ system_info.python_version }}</td></tr>
      </tbody>
    </table>
  </div>
  <div class="section-download">
    <button class="dl-btn" onclick="downloadJSON('system_info')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      system_info.json
    </button>
  </div>
</section>
{% endif %}

</div>

<footer>
  For how the corpus was built, why timing uses best-of-N, and the memory-measurement
  gotcha this report ran into, see
  <a href="https://github.com/MohammadRaziei/pygixml/blob/main/benchmarks/README.md">benchmarks/README.md</a>.
