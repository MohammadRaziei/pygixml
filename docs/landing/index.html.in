<script>
function switchTab(name) {
  document.querySelectorAll('#ex-tabs .tab-btn').forEach(b => {
    const active = b.dataset.tab === name;
    b.classList.toggle('border-brand', active);
    b.classList.toggle('text-brand', active);
    b.classList.toggle('border-transparent', !active);
    b.classList.toggle('text-dim', !active);
  });
  document.querySelectorAll('.tab-content').forEach(p => p.classList.toggle('hidden', p.id !== 'ex-' + name));
}
function copyText(btn, text) {
  navigator.clipboard.writeText(text).then(() => {
    btn.classList.add('text-brand');
    setTimeout(() => btn.classList.remove('text-brand'), 1500);
  });
}
function copyCode(btn) {
  const code = btn.closest('div').querySelector('pre code');
  navigator.clipboard.writeText(code.innerText).then(() => {
    btn.classList.add('text-brand');
    setTimeout(() => btn.classList.remove('text-brand'), 1500);
  });
}
if (window.hljs) { hljs.highlightAll(); }
</script>
</body>
</html>
