  <div>
    <div class="font-mono text-xs uppercase tracking-wider text-fg0 mb-3">Resources</div>
    <div class="flex flex-col gap-2.5 text-sm">
      <a href="docs/index.html" class="flex items-center gap-2 hover:text-brand transition-colors">
